{
  "opencollection": "1.0.0",
  "info": {
    "name": "Passbase Verifications Identity Project API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Project",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get project settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.passbase.com/verification/v2/settings"
          },
          "docs": "Get the settings of your project."
        }
      ]
    }
  ],
  "bundled": true
}